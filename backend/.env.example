# Backend Environment Variables
# Copy this file to .env and fill in real values

# ─── SERVER ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_jwt_secret_here_min_64_chars
JWT_EXPIRES_IN=8h

# ─── ADMIN SEED ───────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123   # This plain password gets hashed on first seed run

